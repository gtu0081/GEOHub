{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yao.example/geo/schemas/geo-brief.schema.json",
  "title": "GEO Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "brief_id", "subject", "seed_queries"],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "brief_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "brand": {"type": "string"},
    "locale": {"type": "string", "default": "zh-CN"},
    "seed_queries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "audiences": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "competitors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "claim", "source_uri"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "source_uri": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
